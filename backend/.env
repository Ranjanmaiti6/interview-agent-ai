# Server Configuration
PORT=5000
NODE_ENV=development

# LLM Provider API Keys (Choose or use both depending on your integration)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Breeth AI / MCP Memory Layer Configuration (Provided via your Hackathon Starter Pack)
BREETH_API_KEY=your_breeth_pro_api_key_here
BREETH_ENDPOINT=https://api.thebreeth.com/v1

# Database (If using MongoDB Atlas / Supabase later)
MONGO_URI=your_mongodb_connection_string_here
